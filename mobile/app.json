{
  "expo": {
    "name": "ISL Interpreter",
    "slug": "isl-interpreter",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f8fafc"
    },
    "platforms": [
      "android"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The interpreter reads hand signs from the camera. Video stays on this phone."
        }
      ],
      "expo-screen-orientation"
    ],
    "android": {
      "package": "com.islinterpreter.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA"
      ]
    }
  }
}
