{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_APP_URL": "https://REPLACE-WITH-YOUR-RAILWAY-URL" } },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_APP_URL": "https://REPLACE-WITH-YOUR-RAILWAY-URL" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_APP_URL": "https://REPLACE-WITH-YOUR-RAILWAY-URL" }
    }
  },
  "submit": { "production": {} }
}
